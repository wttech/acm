# ACM MCP server — AEM connection settings
# Copy to .env and fill in ONE of the auth options below.
#
# NOTE: only test/smoke.mjs reads .env. The server itself takes plain
# environment variables — for MCP use, configure them in the MCP client
# config (env block / --env flags) instead.

# Required: AEM author instance URL
# AEMaaCS:    https://author-pXXXX-eYYYY.adobeaemcloud.com
# Local SDK:  http://localhost:4502
AEM_BASE_URL=

# --- Option A: bearer token (AEMaaCS) ---------------------------------------
# Cloud Manager -> Developer Console -> Integrations -> Local token (valid 24h)
#AEM_TOKEN=

# --- Option B: basic auth (local AEM SDK) -----------------------------------
#AEM_USER=admin
#AEM_PASSWORD=admin

# --- Option C: browser cookie ------------------------------------------------
# Value of the `login-token` cookie from DevTools after logging into author
#AEM_COOKIE=

# Same value, kept in a file that is re-read on every request, so refreshing the
# token needs no restart. Takes precedence over AEM_COOKIE.
#AEM_COOKIE_FILE=

# Optional: set to true when pointing at PROD (disables code execution tools)
#ACM_READONLY=true

# Optional tuning (defaults shown)
#ACM_RUN_TIMEOUT_MS=120000
#ACM_POLL_INTERVAL_MS=1500
#AEM_HTTP_TIMEOUT_MS=30000
