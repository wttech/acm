# ACM MCP server — connection settings for test/smoke.mjs
#
# NOTE: only test/smoke.mjs reads .env. The server itself takes
# ACM_CONFIG_FILE or ACM_CONFIG from the environment — for MCP use,
# configure them in the MCP client config (env block) instead.

# Path to the ACM config document (see README.md for the format), or:
#ACM_CONFIG_FILE=./acm-config.json

# the same document inline:
#ACM_CONFIG={"acm.instances": [{"name": "author", "url": "http://localhost:4502", "authMode": "basic", "user": "admin"}]}
